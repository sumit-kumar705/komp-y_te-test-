# KOMPLYTE Backend Environment Configuration
# Copy this file to .env and fill in your values

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database (Railway MySQL or local SQLite)
# Railway will automatically set MYSQL_URL when you provision a MySQL database
# MYSQL_URL=mysql+pymysql://user:pass@host:3306/database

# Email Configuration (for order confirmations)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=support@komplyte.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Business Configuration
SHIPPING_FREE_THRESHOLD=2000
SHIPPING_CHARGE=49
CONSULTATION_FREE_MINUTES=20
CONSULTATION_PAID_PRICE=250
CONSULTATION_SESSION_MINUTES=20

# Company Contact
ADMIN_WHATSAPP=918149550229
SUPPORT_EMAIL=support@komplyte.com
COMPANY_NAME=KOMPLYTE

# Admin Account (for setup script)
ADMIN_EMAIL=admin@komplyte.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin
